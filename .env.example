DATABASE_URL=sqlite:///./balatravel.db
SECRET_KEY=change-this-secret-key-with-32-plus-characters

# LLM (obrigatorio — qualquer endpoint compativel com OpenAI)
OPENAI_BASE_URL=https://your-llm-endpoint/openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Busca de lugares (obrigatorio para planejamento de viagens)
SERPAPI_API_KEY=your_serpapi_api_key
SERPAPI_BASE_URL=https://serpapi.com/search.json
SERPAPI_MAX_RESULTS=5

# Rotas (obrigatorio para calculo de tempo de deslocamento)
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key

# Opcional — enriquece resultados mas nao e estritamente necessario
OPENTRIPMAP_API_KEY=your_opentripmap_api_key
OPENTRIPMAP_BASE_URL=https://api.opentripmap.com/0.1/en/places
OPENTRIPMAP_RADIUS_METERS=25000

OPENWEATHER_API_KEY=your_openweather_api_key

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_OSM_ATTRIBUTION=&copy; OpenStreetMap contributors
